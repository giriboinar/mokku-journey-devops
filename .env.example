# ─────────────────────────────────────────────────────────────────────────────
# Mokku Journey DevOps — example environment file.
#
#   cp .env.example .env   # then fill in REAL values below
#
# .env is git-ignored (see .gitignore) — never commit real secrets.
# Only placeholder values live in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Grafana admin password for the production stack (docker-compose.prod.yml).
# REQUIRED: the stack refuses to start if this is empty or unset.
GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: comma-separated CORS origins for the backend API.
# Leave commented out in production — nginx serves the frontend and proxies
# /api from the same origin, so browsers make no cross-origin requests.
# CORS_ORIGINS=https://example.com
