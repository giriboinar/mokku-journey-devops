# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Java / Maven ────────────────────────────────────────────────────────────
target/
*.jar
*.war
*.ear
*.class
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── Node (frontend tooling, if any) ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnp/
.pnp.js
dist/
.parcel-cache/

# ── Terraform ───────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ── Kubernetes / Helm ───────────────────────────────────────────────────────
kubeconfig
*.kubeconfig
helm-values-*.yaml
!helm/**/values*.yaml

# ── Secrets & environment — NEVER commit ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets.yaml
secrets.yml
*secret*.json
!*secret*.example.json
credentials.json
aws-credentials*

# ── IDE / OS ────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs & misc ─────────────────────────────────────────────────────────────
*.log
*.tmp
coverage/
.nyc_output/
