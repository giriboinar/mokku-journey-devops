# Version control
.git/
.gitignore
.github/

# Secrets & environment — never bake into images
.env
.env.*
*.pem
*.key
*.p12
secrets.yaml
secrets.yml
credentials.json
*secret*

# Terraform state & config
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
terraform/

# Python artefacts
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# Java build output
**/target/

# Node artefacts
node_modules/
dist/

# Kubernetes / Helm local values
kubeconfig
helm-values-*.yaml

# Docs & CI (not needed at runtime)
docs/
monitoring/
Jenkinsfile
docker-compose.yml
README.md
LICENSE*

# IDE / OS
.idea/
.vscode/
.DS_Store
*.log
*.tmp
